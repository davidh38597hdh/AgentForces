# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Auth ---
# Production (Vercel production / Docker NODE_ENV=production): always requires Google session.
# Local: leave AUTH_REQUIRED=false and omit Google for guest mesh.
AUTH_REQUIRED=false
AUTH_SECRET=

# Must be named GOOGLE_CLIENT_ID (not GOOGLE_CLIENT)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email magic link (not used by default)
EMAIL_SERVER=
EMAIL_FROM=

# --- LLM (server fallbacks; BYOK still works in UI) ---
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional token control plane ---
TOKEN_CONTROL_URL=
TOKEN_CONTROL_SECRET=

# --- Runtime ---
PORT=3000
DEPLOY_TARGET=docker
# Docker prod with guest (not recommended): ALLOW_GUEST=true
