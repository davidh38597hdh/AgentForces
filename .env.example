# --- App URL (required on non-Vercel hosts) ---
# Public origin users hit (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NextAuth v5 canonical URL (often same as above)
AUTH_URL=http://localhost:3000
# Required when behind reverse proxies / containers
AUTH_TRUST_HOST=true

# --- Auth ---
AUTH_SECRET=generate-a-long-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional magic link email
EMAIL_SERVER=
EMAIL_FROM=

# --- LLM (server fallbacks; BYOK still works in UI) ---
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional token control plane ---
TOKEN_CONTROL_URL=
TOKEN_CONTROL_SECRET=

# --- Runtime ---
PORT=3000
# Deploy target label (vercel | fly | docker | railway | render | other)
DEPLOY_TARGET=docker
